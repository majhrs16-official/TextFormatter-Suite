{
  "name": "iflow-compiler",
  "version": "1.0.0",
  "description": "iFlow VM assembler - compiles .flowasm to .flow (iflow-16) or .rom (iflow-32)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run test:validation && npm run test:determinism && npm run test:disasm && npm run test:cli && npm run test:v3",
    "test:validation": "node test/validation/run.js",
    "test:determinism": "node test/determinism/run.js",
    "test:disasm": "node test/disasm/run.js",
    "test:cli": "node test/cli/run.js",
    "test:v3": "node test/v3/run.js",
    "test:jest": "jest",
    "dev": "ts-node src/cli.ts"
  },
  "bin": {
    "iflow-as": "dist/cli.js",
    "iflow-dis": "dist/disasm-cli.js"
  },
  "dependencies": {
    "commander": "^11.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.2",
    "jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
