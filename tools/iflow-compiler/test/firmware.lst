  17: .const SERVICE_STATE_WRITE   0x0501
  18: .const SERVICE_CHANNEL_RESOLVE 0x0600
  19: 
  20: .const SCOPE_MESSAGE         0x01
  21: .const SCOPE_EMITTER         0x02
  22: .const PROP_CONTENT          0x0010
