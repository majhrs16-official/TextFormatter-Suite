  66: 
  67: ; ============================================================
  68: ; TEST 1: Arithmetic and Logic Instructions
  69: ; ============================================================
  70: test_arithmetic:
  71:     ; ADD: R1 = 10 + 20 = 30
  72:     LI R1, 10
  73:     LI R2, 20
  74:     ADD R1, R2
  75:     ; R1 should be 30
  76:     
  77:     ; SUB: R1 = 30 - 5 = 25
  78:     LI R2, 5
  79:     SUB R1, R2
  80:     
  81:     ; MUL: R1 = 25 * 2 = 50
  82:     LI R2, 2
  83:     MUL R1, R2
  84:     
  85:     ; DIV: R1 = 50 / 5 = 10
  86:     LI R2, 5
  87:     DIV R1, R2
  88:     
  89:     ; MOD: R1 = 10 % 3 = 1
  90:     LI R2, 3
  91:     MOD R1, R2
  92:     
  93:     ; AND: R1 = 1 & 0xFF = 1
  94:     LI R2, 0xFF
  95:     AND R1, R2
  96:     
  97:     ; OR: R1 = 1 | 0xF0 = 0xF1
  98:     LI R2, 0xF0
  99:     OR R1, R2
 100:     
 101:     ; XOR: R1 = 0xF1 ^ 0xFF = 0x0E
 102:     LI R2, 0xFF
 103:     XOR R1, R2
 104:     
 105:     ; NOT: R1 = ~0x0E = 0xFFF1 (16-bit)
 106:     NOT R1
 107:     
 108:     RET
 109: 
 110: ; ============================================================
 111: ; TEST 2: Memory Operations (LDB, LDW, STB, STW)
 112: ; ============================================================
 113: test_memory:
 114:     ; Store word at TEST_BUFFER
 115:     LI R1, 0x1234
 116:     STW R1, TEST_BUFFER
 117:     
 118:     ; Load word from TEST_BUFFER
 119:     LDW R2, TEST_BUFFER
 120:     ; R2 should be 0x1234
 121:     
 122:     ; Store byte at TEST_BUFFER+2
 123:     LI R1, 0xAB
 124:     STB R1, TEST_BUFFER + 2
 125:     
 126:     ; Load byte from TEST_BUFFER+2
 127:     LDB R2, TEST_BUFFER + 2
 128:     ; R2 should be 0xAB
 129:     
 130:     ; Test with different addresses
 131:     LI R1, 0x5678
 132:     STW R1, TEST_BUFFER + 4
 133:     LDW R2, TEST_BUFFER + 4
 134:     
 135:     RET
 136: 
 137: ; ============================================================
 138: ; TEST 3: Control Flow (JMP, JZ, JNZ, JC, JV, CALL, RET)
 139: ; ============================================================
 140: test_control_flow:
 141:     ; Test JMP
 142:     LI R1, 0
 143:     JMP test_jmp_target
 144:     LI R1, 1  ; Should be skipped
 145: test_jmp_target:
 146:     
 147:     ; Test JZ (Jump if Zero)
 148:     LI R1, 0
 149:     CMP R1, R0  ; Compare with 0 (R0=0)
 150:     JZ test_jz_taken
 151:     LI R1, 1  ; Should be skipped
 152: test_jz_taken:
 153:     
 154:     ; Test JNZ (Jump if Not Zero)
 155:     LI R1, 5
 156:     CMP R1, R0
 157:     JNZ test_jnz_taken
 158:     LI R1, 1  ; Should be skipped
 159: test_jnz_taken:
 160:     
 161:     ; Test JC (Jump if Carry) - using ADD that overflows
 162:     LI R1, 0xFFFF
 163:     LI R2, 1
 164:     ADD R1, R2  ; Should set carry flag
 165:     JC test_jc_taken
 166:     LI R1, 1  ; Should be skipped
 167: test_jc_taken:
 168:     
 169:     ; Test JV (Jump if Overflow) - using ADD that overflows signed
 170:     LI R1, 0x7FFF
 171:     LI R2, 1
 172:     ADD R1, R2  ; Should set overflow flag
 173:     JV test_jv_taken
 174:     LI R1, 1  ; Should be skipped
 175: test_jv_taken:
 176:     
 177:     ; Test CALL/RET with nested calls
 178:     CALL nested_call_1
 179:     RET
 180: 
 181: nested_call_1:
 182:     CALL nested_call_2
 183:     RET
 184: 
 185: nested_call_2:
 186:     RET
 187: 
 188: ; ============================================================
 189: ; TEST 4: HOST Services
 190: ; ============================================================
 191: test_host_services:
 192:     ; HOST ABI v2: R0=service, R1=options, R2=base (vaddr), R3=length
 193:     ; Returns: R0=status, R3=bytes transferred, R4=scalar result
 194:     ; (R1/R2 are preserved.)
 195: 
 196:     ; PROPERTY_READ: options = (scope<<8) | propId  ->  0x0110 = MESSAGE/content
 197:     LI R0, SERVICE_PROPERTY_READ
 198:     LI R1, 0x0110
 199:     LI R2, RESULT_BUFFER
 200:     LI R3, 0x0100
 201:     HOST
 202:     ; R0 = status, R3 = bytes written
 203: 
 204:     ; PROPERTY_WRITE: options = 0x0111 = MESSAGE/channel
 205:     LI R0, SERVICE_PROPERTY_WRITE
 206:     LI R1, 0x0111
 207:     LI R2, TEST_BUFFER
 208:     LI R3, 0x0008
 209:     HOST
 210: 
 211:     ; PERMISSION_CHECK: buffer = "actor\0perm"
 212:     LI R0, SERVICE_PERM_CHECK
 213:     LI R2, TEST_BUFFER
 214:     LI R3, 0x0010
 215:     HOST
 216:     ; R4 = 0 (denied) | 1 (granted)
 217: 
 218:     ; ROUTE_DECISION: options = decision code
 219:     LI R0, SERVICE_ROUTE_DECISION
 220:     LI R1, DECISION_LOG
 221:     HOST
 222: 
 223:     ; STATE_READ: options = key
 224:     LI R0, SERVICE_STATE_READ
 225:     LI R1, 0x0001
 226:     LI R2, RESULT_BUFFER
 227:     LI R3, 0x0100
 228:     HOST
 229: 
 230:     ; STATE_WRITE: options = key
 231:     LI R0, SERVICE_STATE_WRITE
 232:     LI R1, 0x0001
 233:     LI R2, TEST_BUFFER
 234:     LI R3, 0x0008
 235:     HOST
 236: 
 237:     ; CHANNEL_RESOLVE: reads the name, writes the id back to the same buffer
 238:     LI R0, SERVICE_CHANNEL_RESOLVE
 239:     LI R2, TEST_BUFFER
 240:     LI R3, 0x0008
 241:     HOST
 242: 
 243:     RET
 244: 
 245: ; ============================================================
 246: ; TEST 5: Block Operations (COPY, MOVE)
 247: ; ============================================================
 248: test_block_ops:
 249:     ; Prepare source data
 250:     LI R1, 0x1111
 251:     STW R1, TEST_BUFFER
 252:     LI R1, 0x2222
 253:     STW R1, TEST_BUFFER + 2
 254:     LI R1, 0x3333
 255:     STW R1, TEST_BUFFER + 4
 256:     
 257:     ; COPY: src=TEST_BUFFER, dst=RESULT_BUFFER, len=6 bytes
 258:     COPY TEST_BUFFER, RESULT_BUFFER, 6
 259:     
 260:     ; Verify copy
 261:     LDW R1, RESULT_BUFFER
 262:     ; R1 should be 0x1111
 263:     LDW R2, RESULT_BUFFER + 2
 264:     ; R2 should be 0x2222
 265:     
 266:     ; MOVE: overlapping regions
 267:     MOVE TEST_BUFFER, TEST_BUFFER + 2, 4
 268:     
 269:     RET
 270: 
 271: ; ============================================================
 272: ; TEST 6: Comparison and Conditional Logic
 273: ; ============================================================
 274: test_comparison:
 275:     ; CMP (signed): R1 = 100, R2 = 50
 276:     LI R1, 100
 277:     LI R2, 50
 278:     CMP R1, R2  ; Sets flags: R1 > R2
 279:     
 280:     ; CMPU (unsigned): R1 = 0xFFFF, R2 = 1
 281:     LI R1, 0xFFFF
 282:     LI R2, 1
 283:     CMPU R1, R2  ; Unsigned: R1 > R2
 284:     
 285:     ; Test loop with counter
 286:     LI R1, 10       ; Counter
 287:     LI R2, 0        ; Accumulator
 288:     LI R3, 1        ; Decrement value
 289: loop_start:
 290:     ADD R2, R1      ; Accumulate
 291:     SUB R1, R3      ; Decrement
 292:     CMP R1, R0      ; Compare with 0
 293:     JNZ loop_start  ; Loop until zero
 294:     ; R2 should be 55 (10+9+...+1)
 295:     
 296:     RET
 297: 
 298: ; ============================================================
 299: ; TEST 7: Shift Operations
 300: ; ============================================================
 301: test_shifts:
 302:     ; SHL: 1 << 4 = 16
 303:     LI R1, 1
 304:     LI R2, 4
 305:     SHL R1, R2
 306:     
 307:     ; SHR: 16 >> 2 = 4
 308:     LI R1, 16
 309:     LI R2, 2
 310:     SHR R1, R2
 311:     
 312:     ; SAR: arithmetic shift right (preserves sign)
 313:     LI R1, -16      ; 0xFFF0
 314:     LI R2, 2
 315:     SAR R1, R2      ; Should be -4 (0xFFFC)
 316:     
 317:     RET
