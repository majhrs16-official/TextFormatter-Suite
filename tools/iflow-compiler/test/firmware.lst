; Source:
   1: ; iFlow VM Firmware Test Program
   2: ; Tests all instructions and HOST services
   3: ; Assembled with the firmware ROM enabled (default): the ROM occupies
   4: ; 0x0000-0x0FFF, so this program is placed at 0x1000 (page 1).
   5: .entry main
   6: 
   7: .section code
   8: 
   9: ; ============================================================
  10: ; CONSTANTS
  11: ; ============================================================
  12: .const SERVICE_PROPERTY_READ  0x0100
  13: .const SERVICE_PROPERTY_WRITE 0x0101
  14: .const SERVICE_PERM_CHECK    0x0200
  15: .const SERVICE_ROUTE_DECISION 0x0300
