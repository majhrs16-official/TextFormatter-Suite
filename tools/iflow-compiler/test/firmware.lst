  67: ; ============================================================
  68: ; TEST 1: Arithmetic and Logic Instructions
  69: ; ============================================================
  70: test_arithmetic:
  71:     ; ADD: R1 = 10 + 20 = 30
  72:     LI R1, 10
  73:     LI R2, 20
  74:     ADD R1, R2
  75:     ; R1 should be 30
  76:     
  77:     ; SUB: R1 = 30 - 5 = 25
  78:     LI R2, 5
  79:     SUB R1, R2
  80:     
  81:     ; MUL: R1 = 25 * 2 = 50
  82:     LI R2, 2
  83:     MUL R1, R2
  84:     
  85:     ; DIV: R1 = 50 / 5 = 10
  86:     LI R2, 5
  87:     DIV R1, R2
  88:     
  89:     ; MOD: R1 = 10 % 3 = 1
  90:     LI R2, 3
  91:     MOD R1, R2
  92:     
  93:     ; AND: R1 = 1 & 0xFF = 1
  94:     LI R2, 0xFF
  95:     AND R1, R2
  96:     
  97:     ; OR: R1 = 1 | 0xF0 = 0xF1
  98:     LI R2, 0xF0
  99:     OR R1, R2
 100:     
 101:     ; XOR: R1 = 0xF1 ^ 0xFF = 0x0E
 102:     LI R2, 0xFF
 103:     XOR R1, R2
 104:     
 105:     ; NOT: R1 = ~0x0E = 0xFFF1 (16-bit)
 106:     NOT R1
 107:     
 108:     RET
