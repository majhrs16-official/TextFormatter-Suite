 272: ; ============================================================
 273: ; TEST 6: Comparison and Conditional Logic
 274: ; ============================================================
 275: test_comparison:
 276:     ; CMP (signed): R1 = 100, R2 = 50
 277:     LI R1, 100
 278:     LI R2, 50
 279:     CMP R1, R2  ; Sets flags: R1 > R2
 280:     
 281:     ; CMPU (unsigned): R1 = 0xFFFF, R2 = 1
 282:     LI R1, 0xFFFF
 283:     LI R2, 1
 284:     CMPU R1, R2  ; Unsigned: R1 > R2
 285:     
 286:     ; Test loop with counter
 287:     LI R1, 10       ; Counter
 288:     LI R2, 0        ; Accumulator
 289:     LI R3, 1        ; Decrement value
 290: loop_start:
 291:     ADD R2, R1      ; Accumulate
 292:     SUB R1, R3      ; Decrement
 293:     CMP R1, R0      ; Compare with 0
 294:     JNZ loop_start  ; Loop until zero
 295:     ; R2 should be 55 (10+9+...+1)
 296:     
 297:     RET
 298: 
 299: ; ============================================================
 300: ; TEST 7: Shift Operations
 301: ; ============================================================
 302: test_shifts:
 303:     ; SHL: 1 << 4 = 16
 304:     LI R1, 1
 305:     LI R2, 4
 306:     SHL R1, R2
 307:     
 308:     ; SHR: 16 >> 2 = 4
 309:     LI R1, 16
 310:     LI R2, 2
 311:     SHR R1, R2
 312:     
 313:     ; SAR: arithmetic shift right (preserves sign)
 314:     LI R1, -16      ; 0xFFF0
 315:     LI R2, 2
 316:     SAR R1, R2      ; Should be -4 (0xFFFC)
 317:     
 318:     RET
