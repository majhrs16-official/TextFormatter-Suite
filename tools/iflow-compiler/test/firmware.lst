 249: test_block_ops:
 250:     ; Prepare source data
 251:     LI R1, 0x1111
 252:     STW R1, TEST_BUFFER
 253:     LI R1, 0x2222
 254:     STW R1, TEST_BUFFER + 2
 255:     LI R1, 0x3333
 256:     STW R1, TEST_BUFFER + 4
