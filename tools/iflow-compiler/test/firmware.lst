  39: main:
  40:     ; Stack pointer and frame pointer are initialized by VM (SP=0x6000, FP=0x6000)
  41:     
  42:     ; Test 1: Basic arithmetic and logic
  43:     CALL test_arithmetic
  44:     
  45:     ; Test 2: Memory operations
  46:     CALL test_memory
  47:     
  48:     ; Test 3: Control flow (jumps, calls, returns)
  49:     CALL test_control_flow
