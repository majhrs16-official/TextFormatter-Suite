  40: main:
  41:     ; Stack pointer and frame pointer are initialized by VM (SP=0x7000, FP=0x7000)
  42:     
  43:     ; Test 1: Basic arithmetic and logic
  44:     CALL test_arithmetic
  45:     
  46:     ; Test 2: Memory operations
  47:     CALL test_memory
  48:     
  49:     ; Test 3: Control flow (jumps, calls, returns)
  50:     CALL test_control_flow
  51:     
  52:     ; Test 4: HOST services
  53:     CALL test_host_services
  54:     
  55:     ; Test 5: Block operations (COPY, MOVE)
  56:     CALL test_block_ops
  57:     
