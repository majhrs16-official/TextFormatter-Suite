  59:     CALL test_comparison
  60:     
  61:     ; Test 7: Shift operations
  62:     CALL test_shifts
  63:     
  64:     ; Test 8: Firmware ROM utilities (CALL into the ROM)
  65:     CALL test_firmware_rom
  66:     
  67:     ; All tests passed - halt with success
  68:     LI R0, 0x0000
  69:     HALT
  70: 
  71: ; ============================================================
  72: ; TEST 1: Arithmetic and Logic Instructions
  73: ; ============================================================
  74: test_arithmetic:
  75:     ; ADD: R1 = 10 + 20 = 30
  76:     LI R1, 10
  77:     LI R2, 20
  78:     ADD R1, R2
  79:     ; R1 should be 30
  80:     
  81:     ; SUB: R1 = 30 - 5 = 25
  82:     LI R2, 5
  83:     SUB R1, R2
  84:     
  85:     ; MUL: R1 = 25 * 2 = 50
  86:     LI R2, 2
  87:     MUL R1, R2
  88:     
  89:     ; DIV: R1 = 50 / 5 = 10
  90:     LI R2, 5
  91:     DIV R1, R2
  92:     
  93:     ; MOD: R1 = 10 % 3 = 1
  94:     LI R2, 3
  95:     MOD R1, R2
  96:     
  97:     ; AND: R1 = 1 & 0xFF = 1
  98:     LI R2, 0xFF
  99:     AND R1, R2
 100:     
 101:     ; OR: R1 = 1 | 0xF0 = 0xF1
 102:     LI R2, 0xF0
 103:     OR R1, R2
 104:     
 105:     ; XOR: R1 = 0xF1 ^ 0xFF = 0x0E
 106:     LI R2, 0xFF
 107:     XOR R1, R2
 108:     
 109:     ; NOT: R1 = ~0x0E = 0xFFF1 (16-bit)
 110:     NOT R1
 111:     
 112:     RET
 113: 
 114: ; ============================================================
 115: ; TEST 2: Memory Operations (LDB, LDW, STB, STW)
 116: ; ============================================================
 117: test_memory:
 118:     ; Store word at TEST_BUFFER
 119:     LI R1, 0x1234
 120:     STW R1, TEST_BUFFER
 121:     
 122:     ; Load word from TEST_BUFFER
 123:     LDW R2, TEST_BUFFER
 124:     ; R2 should be 0x1234
 125:     
 126:     ; Store byte at TEST_BUFFER+2
 127:     LI R1, 0xAB
 128:     STB R1, TEST_BUFFER + 2
 129:     
 130:     ; Load byte from TEST_BUFFER+2
 131:     LDB R2, TEST_BUFFER + 2
 132:     ; R2 should be 0xAB
 133:     
 134:     ; Test with different addresses
 135:     LI R1, 0x5678
 136:     STW R1, TEST_BUFFER + 4
 137:     LDW R2, TEST_BUFFER + 4
 138:     
 139:     RET
 140: 
 141: ; ============================================================
 142: ; TEST 3: Control Flow (JMP, JZ, JNZ, JC, JV, CALL, RET)
 143: ; ============================================================
 144: test_control_flow:
 145:     ; Test JMP
 146:     LI R1, 0
 147:     JMP test_jmp_target
 148:     LI R1, 1  ; Should be skipped
 149: test_jmp_target:
 150:     
 151:     ; Test JZ (Jump if Zero)
 152:     LI R1, 0
 153:     CMP R1, R0  ; Compare with 0 (R0=0)
 154:     JZ test_jz_taken
 155:     LI R1, 1  ; Should be skipped
 156: test_jz_taken:
 157:     
 158:     ; Test JNZ (Jump if Not Zero)
 159:     LI R1, 5
 160:     CMP R1, R0
 161:     JNZ test_jnz_taken
 162:     LI R1, 1  ; Should be skipped
 163: test_jnz_taken:
 164:     
 165:     ; Test JC (Jump if Carry) - using ADD that overflows
 166:     LI R1, 0xFFFF
 167:     LI R2, 1
 168:     ADD R1, R2  ; Should set carry flag
 169:     JC test_jc_taken
 170:     LI R1, 1  ; Should be skipped
 171: test_jc_taken:
 172:     
 173:     ; Test JV (Jump if Overflow) - using ADD that overflows signed
 174:     LI R1, 0x7FFF
 175:     LI R2, 1
 176:     ADD R1, R2  ; Should set overflow flag
 177:     JV test_jv_taken
 178:     LI R1, 1  ; Should be skipped
 179: test_jv_taken:
 180:     
 181:     ; Test CALL/RET with nested calls
 182:     CALL nested_call_1
 183:     RET
 184: 
 185: nested_call_1:
 186:     CALL nested_call_2
 187:     RET
 188: 
 189: nested_call_2:
 190:     RET
 191: 
 192: ; ============================================================
 193: ; TEST 4: HOST Services
 194: ; ============================================================
 195: test_host_services:
 196:     ; HOST ABI v2: R0=service, R1=options, R2=base (vaddr), R3=length
 197:     ; Returns: R0=status, R3=bytes transferred, R4=scalar result
 198:     ; (R1/R2 are preserved.)
 199: 
 200:     ; PROPERTY_READ: options = (scope<<8) | propId  ->  0x0110 = MESSAGE/content
 201:     LI R0, SERVICE_PROPERTY_READ
 202:     LI R1, 0x0110
 203:     LI R2, RESULT_BUFFER
 204:     LI R3, 0x0100
 205:     HOST
 206:     ; R0 = status, R3 = bytes written
 207: 
 208:     ; PROPERTY_WRITE: options = 0x0111 = MESSAGE/channel
 209:     LI R0, SERVICE_PROPERTY_WRITE
 210:     LI R1, 0x0111
 211:     LI R2, TEST_BUFFER
 212:     LI R3, 0x0008
 213:     HOST
 214: 
 215:     ; PERMISSION_CHECK: buffer = "actor\0perm"
 216:     LI R0, SERVICE_PERM_CHECK
 217:     LI R2, TEST_BUFFER
 218:     LI R3, 0x0010
 219:     HOST
 220:     ; R4 = 0 (denied) | 1 (granted)
 221: 
 222:     ; ROUTE_DECISION: options = decision code
 223:     LI R0, SERVICE_ROUTE_DECISION
 224:     LI R1, DECISION_LOG
 225:     HOST
 226: 
 227:     ; STATE_READ: options = key
 228:     LI R0, SERVICE_STATE_READ
 229:     LI R1, 0x0001
 230:     LI R2, RESULT_BUFFER
 231:     LI R3, 0x0100
 232:     HOST
 233: 
 234:     ; STATE_WRITE: options = key
 235:     LI R0, SERVICE_STATE_WRITE
 236:     LI R1, 0x0001
 237:     LI R2, TEST_BUFFER
 238:     LI R3, 0x0008
 239:     HOST
 240: 
 241:     ; CHANNEL_RESOLVE: reads the name, writes the id back to the same buffer
 242:     LI R0, SERVICE_CHANNEL_RESOLVE
 243:     LI R2, TEST_BUFFER
 244:     LI R3, 0x0008
 245:     HOST
 246: 
 247:     RET
 248: 
 249: ; ============================================================
 250: ; TEST 5: Block Operations (COPY, MOVE)
 251: ; ============================================================
 252: test_block_ops:
 253:     ; Prepare source data
 254:     LI R1, 0x1111
 255:     STW R1, TEST_BUFFER
 256:     LI R1, 0x2222
 257:     STW R1, TEST_BUFFER + 2
 258:     LI R1, 0x3333
 259:     STW R1, TEST_BUFFER + 4
 260:     
 261:     ; COPY: src=TEST_BUFFER, dst=RESULT_BUFFER, len=6 bytes
 262:     COPY TEST_BUFFER, RESULT_BUFFER, 6
 263:     
 264:     ; Verify copy
 265:     LDW R1, RESULT_BUFFER
 266:     ; R1 should be 0x1111
 267:     LDW R2, RESULT_BUFFER + 2
 268:     ; R2 should be 0x2222
 269:     
 270:     ; MOVE: overlapping regions
 271:     MOVE TEST_BUFFER, TEST_BUFFER + 2, 4
 272:     
 273:     RET
 274: 
 275: ; ============================================================
 276: ; TEST 6: Comparison and Conditional Logic
 277: ; ============================================================
 278: test_comparison:
 279:     ; CMP (signed): R1 = 100, R2 = 50
 280:     LI R1, 100
 281:     LI R2, 50
 282:     CMP R1, R2  ; Sets flags: R1 > R2
 283:     
 284:     ; CMPU (unsigned): R1 = 0xFFFF, R2 = 1
 285:     LI R1, 0xFFFF
 286:     LI R2, 1
 287:     CMPU R1, R2  ; Unsigned: R1 > R2
 288:     
 289:     ; Test loop with counter
 290:     LI R1, 10       ; Counter
 291:     LI R2, 0        ; Accumulator
 292:     LI R3, 1        ; Decrement value
 293: loop_start:
 294:     ADD R2, R1      ; Accumulate
 295:     SUB R1, R3      ; Decrement
 296:     CMP R1, R0      ; Compare with 0
 297:     JNZ loop_start  ; Loop until zero
 298:     ; R2 should be 55 (10+9+...+1)
 299:     
 300:     RET
 301: 
 302: ; ============================================================
 303: ; TEST 7: Shift Operations
 304: ; ============================================================
 305: test_shifts:
 306:     ; SHL: 1 << 4 = 16
 307:     LI R1, 1
 308:     LI R2, 4
 309:     SHL R1, R2
 310:     
 311:     ; SHR: 16 >> 2 = 4
 312:     LI R1, 16
 313:     LI R2, 2
 314:     SHR R1, R2
 315:     
 316:     ; SAR: arithmetic shift right (preserves sign)
 317:     LI R1, -16      ; 0xFFF0
 318:     LI R2, 2
 319:     SAR R1, R2      ; Should be -4 (0xFFFC)
 320:     
 321:     RET
 322: 
 323: ; ============================================================
 324: ; TEST 8: Firmware ROM utilities (calls into the ROM)
 325: ; ============================================================
 326: test_firmware_rom:
 327:     ; Write "Hi\0" into FW_STR (STW is little-endian: low byte first).
 328:     LI R1, 0x6948      ; 0x48 = 'H' (low), 0x69 = 'i' (high)
 329:     STW R1, FW_STR
 330:     LI R1, 0x0000
 331:     STW R1, FW_STR + 2 ; NUL terminator
 332: 
 333:     ; fw_strlen(R1 = src) -> R0 = length
 334:     LI R1, FW_STR
 335:     CALL fw_strlen
 336: 
 337:     ; Store the result so the host-side test can assert it (expect 2).
 338:     STW R0, RESULT_BUFFER
 339: 
 340:     RET
 341: 
