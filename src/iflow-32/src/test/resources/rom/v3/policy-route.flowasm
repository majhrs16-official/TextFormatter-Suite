; iflow-32 guest program loader (V4 slice).
;
; BIOS (core 0): POST minimo, escaneo de la TOC, page tables y MMU. Publica
; boot_ready antes de encender la MMU. Los demas cores se aparcan.
; BOOT: copia KERNEL de ROM a RAM y salta a su entry point.
; KERNEL: valida PRG3 del unico PROGRAM, copia el segmento a un alias fisico,
; zero-fill hasta memSize, construye el mapeo W^X con U=1, asigna PIDENT y
; MIDENT, entra en modo usuario y espera el ECALL de salida. El programa llama
; a HOST MESSAGE_ID y escribe el estado en su pila.
;
; El host solo mapea el contenedor ROM en 0x0 y valida hash, TOC y PRG3 con
; RomParser. El guest revalida la estructura PRG3 que consume (magic, rangos,
; capacidades) y no recalcula SHA-256 ni interpreta nombres de capacidad: eso
; es identidad del host.
;
; Scratch (RAM fisica; el kernel la accede por el alias 0x9000E000 tras la MMU):
;   0x0200E000 boot.offset      0x0200E004 boot.size
;   0x0200E008 boot.entry       0x0200E00C boot.loadAddress
;   0x0200E010 kernel.offset    0x0200E014 kernel.size
;   0x0200E018 kernel.entry     0x0200E01C kernel.loadAddress
;   0x0200E020 kernel.memSize   0x0200E030 boot marker
;   0x0200E034 trap marker      0x0200E038 trap cause
;   0x0200E040 boot_ready       0x0200E044 kernel_ready
;   0x0200E070 program.offset   0x0200E074 program.size
;   0x0200E078 program.entry    0x0200E07C program.loadAddress
;   0x0200E080 program.memSize  0x0200E084 program.count
;   0x0200E088 PRG3.codeOffset  0x0200E08C PRG3.codeEnd
;   0x0200E090 PRG3.dataOffset  0x0200E094 PRG3.dataEnd
;   0x0200E098 PRG3.capsOffset  0x0200E09C PRG3.capsLength
;   0x0200E0A0 program_loaded   0x0200E0A4 program_done
;   0x0200E0A8 last_host_status 0x0200E0AC last_host_length
;   0x0200E0B0 program.pages
;   0x0200E0B8 pool L2 next   0x0200E0BC pool L2 count
;   0x0200E0C0.. slots {l1, tabla} del mapeo dinamico
;
; Page tables:
;   0x02000000 L1
;   0x02001000..0x02004000 L2 ROM (16 MiB, identidad R/X supervisor)
;   0x02005000 L2 RAM (4 MiB; alias kernel en 0x90000000)
;   0x02006000 L2 kernel (4 MiB, R/X supervisor)
;   0x02008000 L2 alias fisico (0x80400000 -> 0x02800000, R/W supervisor)
;   0x02009000..0x0200DFFF pool de tablas L2 para PROGRAM y pila
;   0x02010000 copia de BOOT (4 KiB)
;   0x02020000 copia de KERNEL (hasta 4 MiB)
;
; Mapa del programa (loadAddress de la TOC, 4 KiB alineada):
;   [loadAddress, loadAddress+memSize) -> 0x02800000 (codigo R/X/U, datos/bss R/W/U)
;   0x7FFFE000 virtual -> 0x02900000 fisico (pila R/W/U; SP = 0x7FFFF000)
;   La guarda 0x7FFFD000 queda sin mapear. Los buffers de la politica viven
;   en .bss del propio PROGRAM, no en direcciones fijas del kernel.
;
; El kernel acepta un unico PROGRAM con memSize <= 0x10000, loadAddress
; alineada y su rango sin tocar la guarda de pila. Fuera de ese contrato falla
; con un marcador BADxxxxxx explicito; no hay relocacion ni fallback.

.section .bios
.org 0x00001000
.entry start
start:
    CSRR R1, COREID
    CMP R1, 0
    JZ core0

park:
    CSRR R1, STATUS
    OR R1, 1
    CSRW STATUS, R1
    HALT
    JMP park

core0:
    MOV R0, 0
    MOV R9, 0x02000000
    MOV SP, 0x023FF000

    ; Escanear la TOC: cabecera en ROM fisica 0.
    MOV R1, [R0 + 28]
    MOV R2, [R0 + 32]
    AND R2, 0xFFFF
    CMP R2, 0
    JZ toc_empty
    MOV R3, R1
scan:
    MOV.B R4, [R3]
    CMP R4, 2
    JNE scan_kernel
    MOV R5, [R3 + 4]
    MOV [R9 + 0xE000], R5
    MOV R5, [R3 + 8]
    MOV [R9 + 0xE004], R5
    MOV R5, [R3 + 16]
    MOV [R9 + 0xE008], R5
    MOV R5, [R3 + 12]
    MOV [R9 + 0xE00C], R5
    JMP scan_next
scan_kernel:
    CMP R4, 3
    JNE scan_program
    MOV R5, [R3 + 4]
    MOV [R9 + 0xE010], R5
    MOV R5, [R3 + 8]
    MOV [R9 + 0xE014], R5
    MOV R5, [R3 + 16]
    MOV [R9 + 0xE018], R5
    MOV R5, [R3 + 12]
    MOV [R9 + 0xE01C], R5
    MOV R5, [R3 + 20]
    MOV [R9 + 0xE020], R5
    JMP scan_next
scan_program:
    CMP R4, 4
    JNE scan_next
    MOV R5, [R9 + 0xE084]
    ADD R5, 1
    MOV [R9 + 0xE084], R5
    MOV R5, [R3 + 4]
    MOV [R9 + 0xE070], R5
    MOV R5, [R3 + 8]
    MOV [R9 + 0xE074], R5
    MOV R5, [R3 + 16]
    MOV [R9 + 0xE078], R5
    MOV R5, [R3 + 12]
    MOV [R9 + 0xE07C], R5
    MOV R5, [R3 + 20]
    MOV [R9 + 0xE080], R5
scan_next:
    ADD R3, 64
    SUB R2, 1
    JNZ scan

    ; Limites de este slice: BOOT en una pagina, KERNEL en 4 MiB.
    MOV R1, [R9 + 0xE004]
    CMP R1, 0x1000
    JHI boot_too_big
    MOV R1, [R9 + 0xE020]
    CMP R1, 0x400000
    JHI kernel_too_big

    ; L1: ROM 0..16 MiB, kernel y alias; el espacio de usuario queda vacio y el
    ; kernel accede a la RAM por 0x90000000 (sin identidad en 0x02000000).
    MOV R1, 0x02000000
    MOV R11, 0x02001000
    OR R11, 1
    MOV [R1 + 0], R11
    MOV R11, 0x02002000
    OR R11, 1
    MOV [R1 + 4], R11
    MOV R11, 0x02003000
    OR R11, 1
    MOV [R1 + 8], R11
    MOV R11, 0x02004000
    OR R11, 1
    MOV [R1 + 12], R11

    ; Vaciar los indices L1 4..511 (todo el espacio de usuario).
    MOV R1, 0x02000010
    MOV R2, 0
    MOV R3, 508
clear_user_l1:
    MOV [R1], R2
    ADD R1, 4
    SUB R3, 1
    JNZ clear_user_l1

    MOV R1, 0x02000000
    MOV R11, 0x02006000
    OR R11, 1
    MOV [R1 + 2048], R11
    MOV R11, 0x02008000
    OR R11, 1
    MOV [R1 + 2052], R11
    MOV R11, 0x02005000
    OR R11, 1
    MOV [R1 + 2304], R11

    ; L2 ROM: 4 tablas de 1024 paginas R/X supervisor.
    MOV R12, 1024
    MOV R1, 0x02001000
    MOV R2, 0x00000000
    CALL fill_rx
    MOV R12, 1024
    MOV R1, 0x02002000
    MOV R2, 0x00400000
    CALL fill_rx
    MOV R12, 1024
    MOV R1, 0x02003000
    MOV R2, 0x00800000
    CALL fill_rx
    MOV R12, 1024
    MOV R1, 0x02004000
    MOV R2, 0x00C00000
    CALL fill_rx

    ; L2 RAM: 1024 paginas R/W supervisor (el kernel no comparte RAM con U).
    MOV R12, 1024
    MOV R1, 0x02005000
    MOV R2, 0x02000000
    CALL fill_rw_sup

    ; L2 kernel: pagina 0 para BOOT, 1..1023 para KERNEL.
    MOV R1, 0x02006000
    MOV R2, 0x02010000
    MOV R3, R2
    OR R3, 0x15
    MOV [R1], R3
    MOV R12, 1023
    MOV R1, 0x02006004
    MOV R2, 0x02020000
    CALL fill_rx

    ; L2 alias fisico: 0x80400000..0x807FFFFF -> 0x02800000..0x02BFFFFF.
    MOV R12, 1024
    MOV R1, 0x02008000
    MOV R2, 0x02800000
    CALL fill_rw_sup

    ; Copiar BOOT a RAM, publicar boot_ready y saltar a su direccion virtual.
    MOV R1, [R9 + 0xE000]
    MOV R2, 0x02010000
    MOV R3, [R9 + 0xE004]
    CALL copy_bytes

    MOV R1, 0x600D0001
    MOV [R9 + 0xE030], R1
    MOV R1, 1
    MOV [R9 + 0xE040], R1

    MOV R1, 0x02000000
    CSRW PTBR, R1
    CSRR R1, STATUS
    OR R1, 0x10
    CSRW STATUS, R1
    MOV R9, 0x90000000
    MOV R5, [R9 + 0xE008]
    JMP R5

toc_empty:
    MOV R1, 0xBAD00000
    MOV [R9 + 0xE030], R1
    CSRR R1, STATUS
    OR R1, 1
    CSRW STATUS, R1
    HALT
boot_too_big:
    MOV R1, 0xBAD00001
    MOV [R9 + 0xE030], R1
    CSRR R1, STATUS
    OR R1, 1
    CSRW STATUS, R1
    HALT
kernel_too_big:
    MOV R1, 0xBAD00002
    MOV [R9 + 0xE030], R1
    CSRR R1, STATUS
    OR R1, 1
    CSRW STATUS, R1
    HALT

; R1 = tabla, R2 = primer frame, R12 = paginas. PTE R/X supervisor.
fill_rx:
    MOV R3, R2
    OR R3, 0x15
    MOV [R1], R3
    ADD R1, 4
    ADD R2, 0x1000
    SUB R12, 1
    JNZ fill_rx
    RET

; R1 = tabla, R2 = primer frame, R12 = paginas. PTE R/W supervisor.
fill_rw_sup:
    MOV R3, R2
    OR R3, 0x0D
    MOV [R1], R3
    ADD R1, 4
    ADD R2, 0x1000
    SUB R12, 1
    JNZ fill_rw_sup
    RET

; R1 = origen, R2 = destino, R3 = bytes.
copy_bytes:
    MOV.B R4, [R1]
    MOV.B [R2], R4
    ADD R1, 1
    ADD R2, 1
    SUB R3, 1
    JNZ copy_bytes
    RET

.section .boot
.org 0x80000000
.entry boot
boot:
    MOV R9, 0x90000000

    ; Copiar KERNEL de ROM (identidad) a su frame RAM.
    MOV R1, [R9 + 0xE010]
    MOV R2, 0x90020000
    MOV R3, [R9 + 0xE014]
boot_copy:
    MOV.B R4, [R1]
    MOV.B [R2], R4
    ADD R1, 1
    ADD R2, 1
    SUB R3, 1
    JNZ boot_copy

    MOV R1, 1
    MOV [R9 + 0xE044], R1

    SFENCE.VMA
    MOV R5, [R9 + 0xE018]
    JMP R5

.section .kernel
.org 0x80001000
.entry kmain

; El hardware salta a TVEC + 4*CAUSE. Cada entrada ocupa 4 bytes: las libres
; contienen ECALL, de modo que cualquier trap sin handler termina en la doble
; falta (vector 14, tambien ECALL) y la VM queda FAULTED de forma explicita.
; El vector 7 (ECALL de usuario) y el 21 (IRQ 5 del mailbox) usan un JMP de
; 7 bytes que solapa el slot siguiente, un vector que este slice no usa.
trap_table:
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    JMP user_exit
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    ECALL
    .space 1
    JMP mailbox_irq
    .space 1
    ECALL
    .space 1

kmain:
    MOV R9, 0x90000000
    MOV SP, 0x903FF000
    MOV R1, trap_table
    CSRW TVEC, R1

    ; Desenmascarar solo la IRQ 5 (mailbox) en el banco del core 0.
    MOV R1, 0x01002004
    MOV R2, 0xFFFFFFDF
    MOV [R1], R2

    ; Sin IRQ pendientes en este slice: timer apagado.
    CSRR R1, STATUS
    OR R1, 1
    CSRW STATUS, R1

    MOV R1, [R9 + 0xE084]
    CMP R1, 1
    JNE bad_count

    ; Validar PRG3 del unico PROGRAM.
    MOV R1, [R9 + 0xE070]
    MOV R2, [R1]
    MOV R3, 0x33475250
    CMP R2, R3
    JNE bad_magic
    MOV R2, [R1 + 4]
    MOV [R9 + 0xE088], R2
    MOV R3, [R1 + 8]
    MOV [R9 + 0xE08C], R3
    MOV R4, [R1 + 12]
    MOV [R9 + 0xE090], R4
    MOV R5, [R1 + 16]
    MOV [R9 + 0xE094], R5
    MOV R6, [R1 + 20]
    MOV [R9 + 0xE098], R6
    MOV R7, [R1 + 24]
    MOV [R9 + 0xE09C], R7
    MOV R8, [R1 + 28]
    CMP R8, 0
    JNE bad_reserved

    MOV R1, [R9 + 0xE074]
    CMP R1, 32
    JAE bad_size
    MOV R1, [R9 + 0xE080]
    CMP R1, 0x10000
    JHI bad_size
    MOV R1, [R9 + 0xE080]
    MOV R2, [R9 + 0xE074]
    CMP R1, R2
    JAE bad_size

    ; loadAddress: 4 KiB alineada, dentro de usuario y sin tocar la guarda de
    ; la pila (0x7FFFD000). El kernel la mapea dinamicamente.
    MOV R1, [R9 + 0xE07C]
    AND R1, 0xFFF
    JNZ bad_load
    MOV R1, [R9 + 0xE07C]
    MOV R2, 0x02000000
    CMP R1, R2
    JAE bad_load
    MOV R1, [R9 + 0xE07C]
    MOV R2, [R9 + 0xE080]
    ADD R1, R2
    MOV R2, 0x7FFFD000
    CMP R1, R2
    JHI bad_load

    MOV R1, [R9 + 0xE078]
    MOV R2, [R9 + 0xE07C]
    SUB R1, R2
    MOV R3, [R9 + 0xE088]
    CMP R1, R3
    JAE bad_entry
    MOV R4, [R9 + 0xE08C]
    CMP R1, R4
    JB bad_entry

    MOV R1, [R9 + 0xE088]
    CMP R1, 32
    JAE bad_code
    MOV R1, [R9 + 0xE08C]
    MOV R2, [R9 + 0xE088]
    CMP R1, R2
    JLS bad_code
    MOV R3, [R9 + 0xE074]
    CMP R1, R3
    JHI bad_code

    MOV R1, [R9 + 0xE090]
    MOV R2, [R9 + 0xE094]
    CMP R2, R1
    JAE bad_data
    CMP R1, 0
    JNZ data_present
    CMP R2, 0
    JNE bad_data
    JMP data_checked
data_present:
    MOV R3, [R9 + 0xE08C]
    CMP R1, R3
    JAE bad_data
    MOV R3, [R9 + 0xE074]
    CMP R2, R3
    JHI bad_data
    MOV R3, [R9 + 0xE080]
    CMP R3, R2
    JAE bad_data
    ; Los datos deben empezar en una pagina propia para conservar W^X.
    MOV R3, [R9 + 0xE08C]
    ADD R3, 0xFFF
    SHR R3, 12
    SHL R3, 12
    CMP R1, R3
    JAE bad_data
    ; bss (memSize > codeEnd) exige codeEnd alineado a pagina para conservar W^X.
    MOV R1, [R9 + 0xE080]
    MOV R2, [R9 + 0xE08C]
    CMP R1, R2
    JLS data_checked
    MOV R3, R2
    AND R3, 0xFFF
    JZ data_checked
    JMP bad_data
data_checked:

    ; Capacidades: blob dentro del segmento y tras codigo/datos.
    MOV R6, [R9 + 0xE098]
    MOV R7, [R9 + 0xE09C]
    CMP R7, 0
    JNE caps_present
    CMP R6, 0
    JNE bad_caps
    JMP caps_ok
caps_present:
    CMP R6, 32
    JAE bad_caps
    MOV R8, [R9 + 0xE08C]
    MOV R1, [R9 + 0xE094]
    CMP R1, R8
    JLS caps_max_done
    MOV R8, R1
caps_max_done:
    CMP R6, R8
    JAE bad_caps
    MOV R1, [R9 + 0xE074]
    SUB R1, R6
    CMP R7, R1
    JHI bad_caps
    CMP R7, 2
    JAE bad_caps
    MOV R1, [R9 + 0xE070]
    ADD R1, R6
    MOV.B R2, [R1]
    MOV.B R5, [R1 + 1]
    SHL R5, 8
    OR R2, R5
    ADD R1, 2
    MOV R3, R1
    ADD R3, R7
    SUB R3, 2
caps_loop:
    CMP R2, 0
    JZ caps_ok
    CMP R1, R3
    JB bad_caps
    MOV.B R4, [R1]
    MOV.B R5, [R1 + 1]
    SHL R5, 8
    OR R4, R5
    CMP R4, 0
    JZ bad_caps
    CMP R4, 128
    JHI bad_caps
    ADD R1, 2
    ADD R1, R4
    CMP R1, R3
    JHI bad_caps
    SUB R2, 1
    JMP caps_loop
caps_ok:

    ; Copiar el segmento completo (PRG3 + codigo + capacidades) al alias.
    MOV R1, [R9 + 0xE070]
    MOV R2, 0x80400000
    MOV R3, [R9 + 0xE074]
    CALL copy_bytes

    ; Zero-fill desde size hasta memSize.
    MOV R1, [R9 + 0xE074]
    MOV R2, 0x80400000
    ADD R2, R1
    MOV R3, [R9 + 0xE080]
    SUB R3, R1
    JZ zero_done
zero_loop:
    MOV R4, 0
    MOV.B [R2], R4
    ADD R2, 1
    SUB R3, 1
    JNZ zero_loop
zero_done:

    ; Pool de tablas L2 y cache de indices L1; el programa puede cruzar 4 MiB.
    MOV R1, 0x02009000
    MOV [R9 + 0xE0B8], R1
    MOV R1, 0
    MOV [R9 + 0xE0BC], R1

    MOV R3, [R9 + 0xE080]
    ADD R3, 0xFFF
    SHR R3, 12
    MOV [R9 + 0xE0B0], R3
    MOV R4, [R9 + 0xE07C]
    MOV R5, 0x02800000
    MOV R6, R3
    MOV R7, [R9 + 0xE08C]
    ADD R7, 0xFFF
    SHR R7, 12
map_pages:
    MOV R1, R4
    SHR R1, 22
    CALL l2_for
    MOV R3, R4
    SHR R3, 12
    AND R3, 0x3FF
    SHL R3, 2
    ADD R3, R2
    ADD R3, 0x8E000000
    MOV R8, R5
    CMP R7, 0
    JZ map_data
    OR R8, 0x35
    SUB R7, 1
    JMP map_store
map_data:
    OR R8, 0x2D
map_store:
    MOV [R3], R8
    ADD R4, 0x1000
    ADD R5, 0x1000
    SUB R6, 1
    JNZ map_pages

    ; Pila de usuario: SP = 0x7FFFF000; pagina 0x7FFFE000 con guarda debajo.
    MOV R1, 0x7FFFE000
    SHR R1, 22
    CALL l2_for
    MOV R3, 0x7FFFE000
    SHR R3, 12
    AND R3, 0x3FF
    SHL R3, 2
    ADD R3, R2
    ADD R3, 0x8E000000
    MOV R8, 0x02900000
    OR R8, 0x2D
    MOV [R3], R8
    FENCE
    SFENCE.VMA

    ; Identidad del programa; el MIDENT se asigna por unidad desde el mailbox.
    MOV R1, 0
    CSRW PIDENT, R1
    MOV R1, 0xFFFFFFFF
    CSRW MIDENT, R1

    MOV R1, 1
    MOV [R9 + 0xE0A0], R1

    ; El kernel queda a la espera; cada unidad entra en U desde el mailbox.
    JMP idle

bad_count:
    MOV R1, 0xBAD00003
    JMP fail
bad_magic:
    MOV R1, 0xBAD00004
    JMP fail
bad_reserved:
    MOV R1, 0xBAD00005
    JMP fail
bad_size:
    MOV R1, 0xBAD00006
    JMP fail
bad_load:
    MOV R1, 0xBAD00007
    JMP fail
bad_entry:
    MOV R1, 0xBAD00008
    JMP fail
bad_code:
    MOV R1, 0xBAD00009
    JMP fail
bad_data:
    MOV R1, 0xBAD0000A
    JMP fail
bad_caps:
    MOV R1, 0xBAD0000B
fail:
    MOV [R9 + 0xE034], R1
    CSRR R1, STATUS
    OR R1, 1
    CSRW STATUS, R1
    HALT

; Vector 7 (ECALL de usuario): cerrar la unidad y volver al idle del kernel.
user_exit:
    MOV R9, 0x90000000
    CSRR R3, CAUSE
    CMP R3, 7
    JNE unexpected_trap
    MOV R1, 0xFFFFFFFF
    CSRW MIDENT, R1
    ; Supervisor + MMU + IE: el JMP a idle debe ejecutarse en modo supervisor.
    MOV R1, 0x13
    CSRW STATUS, R1
    JMP idle

; Espera de la siguiente unidad: HALT hasta que el host publique un mensaje y
; levante la IRQ 5. El handler lee el handle, hace ACK y entra en U.
idle:
    HALT
    JMP idle

; R1 = indice L1. Devuelve R2 = tabla L2 fisica y crea la entrada si falta.
; Conserva R4-R8 (estado del bucle de mapeo) y usa alias 0x90000000 para
; acceder a las tablas; el pool de L2 vive en 0x02009000..0x0200DFFF.
l2_for:
    MOV R13, R1
    MOV R10, R9
    ADD R10, 0xE0C0
    MOV R12, [R9 + 0xE0BC]
l2_lookup:
    CMP R12, 0
    JZ l2_alloc
    MOV R0, [R10]
    CMP R0, R13
    JZ l2_found
    ADD R10, 8
    SUB R12, 1
    JMP l2_lookup
l2_found:
    MOV R2, [R10 + 4]
    RET
l2_alloc:
    MOV R11, [R9 + 0xE0B8]
    MOV R3, R11
    ADD R3, 0x1000
    CMP R3, 0x0200E000
    JHI l2_full
    MOV [R9 + 0xE0B8], R3
    MOV R10, R11
    ADD R10, 0x8E000000
    MOV R12, 1024
    MOV R0, 0
l2_zero:
    MOV [R10], R0
    ADD R10, 4
    SUB R12, 1
    JNZ l2_zero
    MOV R12, [R9 + 0xE0BC]
    MOV R10, R9
    ADD R10, 0xE0C0
    MOV R3, R12
    SHL R3, 3
    ADD R10, R3
    MOV [R10], R13
    MOV [R10 + 4], R11
    ADD R12, 1
    MOV [R9 + 0xE0BC], R12
    MOV R3, R13
    SHL R3, 2
    ADD R3, 0x90000000
    MOV R0, R11
    OR R0, 1
    MOV [R3], R0
    MOV R2, R11
    RET
l2_full:
    MOV R1, 0xBAD0000C
    JMP fail

; Reinicia la RAM del programa antes de cada unidad: recopia el segmento desde
; la ROM, hace zero-fill hasta memSize y limpia la pila de usuario. El kernel
; sigue vivo; solo se restaura el estado del programa.
reset_unit_state:
    MOV R1, [R9 + 0xE070]
    MOV R2, 0x80400000
    MOV R3, [R9 + 0xE074]
reset_copy:
    MOV.B R4, [R1]
    MOV.B [R2], R4
    ADD R1, 1
    ADD R2, 1
    SUB R3, 1
    JNZ reset_copy

    MOV R1, [R9 + 0xE074]
    MOV R2, 0x80400000
    ADD R2, R1
    MOV R3, [R9 + 0xE080]
    SUB R3, R1
    JZ reset_stack
reset_zero:
    MOV R4, 0
    MOV.B [R2], R4
    ADD R2, 1
    SUB R3, 1
    JNZ reset_zero

reset_stack:
    MOV R2, 0x7FFFE000
    MOV R3, 1024
reset_stack_loop:
    MOV R4, 0
    MOV [R2], R4
    ADD R2, 4
    SUB R3, 1
    JNZ reset_stack_loop
    RET

mailbox_irq:
    MOV R9, 0x90000000
    ; Retirar la IRQ 5 de servicio en el PIC antes de validar el evento.
    MOV R3, 0x20
    MOV R2, 0x01002008
    MOV [R2], R3
    MOV R1, 0x01006000
    MOV R2, [R1 + 0x00]
    CMP R2, 1
    JNE unexpected_trap
    MOV R2, [R1 + 0x04]
    CMP R2, 0
    JZ unexpected_trap
    MOV R3, 1
    MOV [R1 + 0x10], R3
    CSRW MIDENT, R2
    MOV SP, 0x903FF000
    CALL reset_unit_state
    MOV SP, 0x7FFFF000
    MOV R3, [R9 + 0xE078]
    CSRW EPC, R3
    MOV R3, 0x36
    CSRW STATUS, R3
    ERET

; Trap inesperado dentro de un handler: ECALL con TRAP ya activo encadena la
; doble falta y deja la VM FAULTED; nunca se ignora en silencio.
unexpected_trap:
    ECALL

.section .program.loader
.org 0x053FF000
.entry program_start
.capability iflow.property.read
.capability iflow.route.decision

; Politica de ejemplo del cableado hub/Router: lee la propiedad
; scope="message" property="content" y decide por el primer byte del texto.
; "b..." cancela el evento; cualquier otro contenido se entrega. Un fallo de
; lectura, una propiedad ausente o un TLV inesperado producen ERROR explicito.
program_start:
    ; La pila debe llegar limpia: el kernel reinicia la RAM del programa en
    ; cada unidad. Un marcador viejo delata aislamiento incompleto.
    MOV R9, 0x7FFFEFFC
    MOV R8, [R9]
    CMP R8, 0
    JNE stale_state
    MOV R8, 0xDEADBEEF
    MOV [R9], R8

    ; Los datos inicializados deben volver de la ROM en cada unidad y el bss
    ; debe quedar a cero. Escribir el marcador del bss delata un reset roto.
    MOV R1, unit_marker
    MOV R2, [R1]
    MOV R3, 0x5A5A
    CMP R2, R3
    JNE bad_data_state
    MOV R1, scratch_marker
    MOV R2, [R1]
    CMP R2, 0
    JNE bad_bss_state
    MOV R2, 0xDEADBEEF
    MOV [R1], R2

    MOV R2, read_args
    MOV R3, 52
    MOV R4, result_buffer
    MOV R5, 1024
    MOV R0, 0x0100
    MOV R1, 0
    HOST

    ; Guardar estado y longitud del resultado para diagnostico.
    MOV R6, host_status
    MOV [R6], R0
    MOV [R6 + 4], R1

    CMP R0, 0
    JNE read_failed

    ; Resultado TLV map {present:bool, value:string} en result_buffer:
    ; +22 bool present, +38 primer byte del contenido (map 5 + present 12 +
    ; bool 6 + clave "value" 10).
    MOV R8, result_buffer
    ADD R8, 0x16
    MOV.B R7, [R8]
    CMP R7, 1
    JNE read_failed

    MOV R8, result_buffer
    ADD R8, 0x26
    MOV.B R7, [R8]
    CMP R7, 0x62
    JZ blocked

    MOV R2, decision_deliver
    MOV R3, 51
    JMP decide

blocked:
    MOV R2, decision_cancel
    MOV R3, 52
    JMP decide

read_failed:
    MOV R2, decision_error
    MOV R3, 50
    JMP decide

stale_state:
    MOV R2, decision_error
    MOV R3, 50
    JMP decide

bad_data_state:
    MOV R2, decision_error
    MOV R3, 50
    JMP decide

bad_bss_state:
    MOV R2, decision_error
    MOV R3, 50
    JMP decide

decide:
    MOV R4, 0
    MOV R5, 0
    MOV R0, 0x0300
    MOV R1, 0
    HOST

    ECALL

program_hang:
    JMP program_hang

; TLV {scope:"message", property:"content"}: 47 bytes de payload.
read_args:
    .byte 6
    .word 47
    .byte 1
    .word 5
    .byte 115, 99, 111, 112, 101
    .byte 1
    .word 7
    .byte 109, 101, 115, 115, 97, 103, 101
    .byte 1
    .word 8
    .byte 112, 114, 111, 112, 101, 114, 116, 121
    .byte 1
    .word 7
    .byte 99, 111, 110, 116, 101, 110, 116

; TLV {target:i64=0, reason:"policy"}: 46 bytes de payload.
decision_deliver:
    .byte 6
    .word 46
    .byte 1
    .word 6
    .byte 116, 97, 114, 103, 101, 116
    .byte 2
    .word 8
    .word 0, 0
    .byte 1
    .word 6
    .byte 114, 101, 97, 115, 111, 110
    .byte 1
    .word 6
    .byte 112, 111, 108, 105, 99, 121

; TLV {target:i64=1, reason:"blocked"}: 47 bytes de payload.
decision_cancel:
    .byte 6
    .word 47
    .byte 1
    .word 6
    .byte 116, 97, 114, 103, 101, 116
    .byte 2
    .word 8
    .word 1, 0
    .byte 1
    .word 6
    .byte 114, 101, 97, 115, 111, 110
    .byte 1
    .word 7
    .byte 98, 108, 111, 99, 107, 101, 100

; TLV {target:i64=2, reason:"error"}: 45 bytes de payload.
decision_error:
    .byte 6
    .word 45
    .byte 1
    .word 6
    .byte 116, 97, 114, 103, 101, 116
    .byte 2
    .word 8
    .word 2, 0
    .byte 1
    .word 6
    .byte 114, 101, 97, 115, 111, 110
    .byte 1
    .word 5
    .byte 101, 114, 114, 111, 114

; El codigo termina en una pagina exacta: los datos y el bss empiezan en la
; pagina siguiente y se mapean R/W, sin compartir pagina con codigo R/X.
.align 4096

.data
unit_marker:
    .word 0x5A5A

.bss
.align 4
host_status:
    .space 4
host_length:
    .space 4
route_status:
    .space 4
route_length:
    .space 4
result_buffer:
    .space 1024
scratch_marker:
    .space 4
