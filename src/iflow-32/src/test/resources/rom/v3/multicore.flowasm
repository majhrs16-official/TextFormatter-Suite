; iflow-32 guest multicore kernel (V3-2b scheduler/IPI/TLB slice).
;
; BIOS (core 0): POST minimo, escaneo de la TOC, page tables y MMU. Publica
; boot_ready antes de encender la MMU. Los cores 1..N-1 esperan kernel_ready
; con la MMU apagada, usan su propia pila y entran al kernel.
; BOOT: copia KERNEL de ROM a RAM, publica kernel_ready y salta al kernel.
; KERNEL: publica sched_ready, prepara la tabla TVEC, cambia un PTE y envia
; una IPI broadcast de linea 16. Cada core secundario lee la pagina de prueba
; antes del cambio, ejecuta SFENCE.VMA en su handler, reconoce el PIC y lee el
; frame nuevo. Despues todos reclaman tareas de una cola compartida con
; AMOADD.W y terminan en HALT.
;
; Scratch (RAM fisica, identidad tras encender la MMU):
;   0x0200E000 boot.offset      0x0200E004 boot.size
;   0x0200E008 boot.entry       0x0200E00C boot.loadAddress
;   0x0200E010 kernel.offset    0x0200E014 kernel.size
;   0x0200E018 kernel.entry     0x0200E01C kernel.loadAddress
;   0x0200E020 kernel.memSize   0x0200E030 boot marker
;   0x0200E034 trap marker      0x0200E038 trap cause
;   0x0200E040 boot_ready       0x0200E044 kernel_ready
;   0x0200E048 sched_ready      0x0200E04C tlb_online
;   0x0200E050 tlb_ack          0x0200E054 tlb_before (core 1)
;   0x0200E058 tlb_after (core 1)
;   0x0200E05C sched_start      0x0200E060 tasks_done
;   0x0200E064 scheduler_done  0x0200E068 secondaries
;   0x0200E080 next_task       0x0200E084 claim_turn
;   0x0200E0C0 tasks_by_core[0..63]
;   0x0200E300 tlb_frame[core] before/after
;
; Page tables:
;   0x02000000 L1
;   0x02001000..0x02004000 L2 ROM (16 MiB, identidad R/X)
;   0x02005000 L2 RAM (4 MiB, identidad R/W/U)
;   0x02006000 L2 kernel (4 MiB, R/X)
;   0x02010000 copia de BOOT (4 KiB)
;   0x02020000 copia de KERNEL (hasta 4 MiB)
;
; Pagina de prueba del shootdown: virtual 0x80101000 (PTE 257). Empieza en el
; frame 0x02120000; el kernel la cambia a 0x02121000.

.section .bios
.org 0x00001000
.entry start
start:
    CSRR R1, COREID
    CMP R1, 0
    JZ core0

; Cores 1..N-1: duermen hasta que el kernel se publique. El core 0 envia una
; IPI broadcast de linea 16 al publicar kernel_ready; el stub de BIOS la
; reconoce y ERET vuelve al bucle, que vuelve a dormir si aun no hay kernel.
secondary:
    MOV R9, 0x02000000
    MOV R1, bios_tvec
    CSRW TVEC, R1
    MOV R1, 0xFFFEFFFF
    MOV R2, 0x01002004
    MOV [R2], R1
    CSRR R1, STATUS
    OR R1, 1
    CSRW STATUS, R1
wait_kernel:
    HALT
    MOV R1, [R9 + 0xE044]
    CMP R1, 0
    JZ wait_kernel

    ; Pila propia: 0x023FF000 - coreid * 0x1000.
    CSRR R2, COREID
    MOV R3, 0x023FF000
    MOV R4, R2
    SHL R4, 12
    SUB R3, R4
    MOV SP, R3

    MOV R1, 0x02000000
    CSRW PTBR, R1
    CSRR R1, STATUS
    OR R1, 0x10
    CSRW STATUS, R1
    SFENCE.VMA
    MOV R5, [R9 + 0xE018]
    JMP R5

core0:
    MOV R0, 0
    MOV R9, 0x02000000
    MOV SP, 0x023FF000

    ; Escanear la TOC: cabecera en ROM fisica 0.
    MOV R1, [R0 + 28]
    MOV R2, [R0 + 32]
    AND R2, 0xFFFF
    MOV R3, R1
scan:
    MOV.B R4, [R3]
    CMP R4, 2
    JNE scan_kernel
    MOV R5, [R3 + 4]
    MOV [R9 + 0xE000], R5
    MOV R5, [R3 + 8]
    MOV [R9 + 0xE004], R5
    MOV R5, [R3 + 16]
    MOV [R9 + 0xE008], R5
    MOV R5, [R3 + 12]
    MOV [R9 + 0xE00C], R5
    JMP scan_next
scan_kernel:
    CMP R4, 3
    JNE scan_next
    MOV R5, [R3 + 4]
    MOV [R9 + 0xE010], R5
    MOV R5, [R3 + 8]
    MOV [R9 + 0xE014], R5
    MOV R5, [R3 + 16]
    MOV [R9 + 0xE018], R5
    MOV R5, [R3 + 12]
    MOV [R9 + 0xE01C], R5
    MOV R5, [R3 + 20]
    MOV [R9 + 0xE020], R5
scan_next:
    ADD R3, 64
    SUB R2, 1
    JNZ scan

    ; Limites de este slice: BOOT en una pagina, KERNEL en 4 MiB.
    MOV R1, [R9 + 0xE004]
    CMP R1, 0x1000
    JHI boot_too_big
    MOV R1, [R9 + 0xE020]
    CMP R1, 0x400000
    JHI kernel_too_big

    ; L1: ROM 0..16 MiB, RAM 0x02000000, kernel 0x80000000.
    MOV R1, 0x02000000
    MOV R11, 0x02001000
    OR R11, 1
    MOV [R1 + 0], R11
    MOV R11, 0x02002000
    OR R11, 1
    MOV [R1 + 4], R11
    MOV R11, 0x02003000
    OR R11, 1
    MOV [R1 + 8], R11
    MOV R11, 0x02004000
    OR R11, 1
    MOV [R1 + 12], R11
    MOV R11, 0x02005000
    OR R11, 1
    MOV [R1 + 32], R11
    MOV R11, 0x02006000
    OR R11, 1
    MOV [R1 + 2048], R11

    ; L2 ROM: 4 tablas de 1024 paginas R/X.
    MOV R12, 1024
    MOV R1, 0x02001000
    MOV R2, 0x00000000
    CALL fill_rx
    MOV R12, 1024
    MOV R1, 0x02002000
    MOV R2, 0x00400000
    CALL fill_rx
    MOV R12, 1024
    MOV R1, 0x02003000
    MOV R2, 0x00800000
    CALL fill_rx
    MOV R12, 1024
    MOV R1, 0x02004000
    MOV R2, 0x00C00000
    CALL fill_rx

    ; L2 RAM: 1024 paginas R/W/U.
    MOV R12, 1024
    MOV R1, 0x02005000
    MOV R2, 0x02000000
    CALL fill_rw

    ; L2 kernel: pagina 0 para BOOT, 1..1023 para KERNEL.
    MOV R1, 0x02006000
    MOV R2, 0x02010000
    MOV R3, R2
    OR R3, 0x15
    MOV [R1], R3
    MOV R12, 1023
    MOV R1, 0x02006004
    MOV R2, 0x02020000
    CALL fill_rx

    ; Copiar BOOT a RAM, publicar boot_ready y saltar a su direccion virtual.
    MOV R1, [R9 + 0xE000]
    MOV R2, 0x02010000
    MOV R3, [R9 + 0xE004]
    CALL copy_bytes

    MOV R1, 0x600D0001
    MOV [R9 + 0xE030], R1
    MOV R1, 1
    MOV [R9 + 0xE040], R1

    MOV R1, 0x02000000
    CSRW PTBR, R1
    CSRR R1, STATUS
    OR R1, 0x10
    CSRW STATUS, R1
    MOV R5, [R9 + 0xE008]
    JMP R5

boot_too_big:
    MOV R1, 0xBAD00001
    MOV [R9 + 0xE030], R1
    HALT
kernel_too_big:
    MOV R1, 0xBAD00002
    MOV [R9 + 0xE030], R1
    HALT

; Despertar desde la IPI de liberacion: reconocer la linea 16 y volver al bucle.
; El hardware salta a TVEC + 4*32, asi que el stub vive en el offset 128.
.align 256
bios_tvec:
    JMP bios_trap
    .space 121
    JMP bios_wake
    .space 121
bios_wake:
    MOV R1, 0x00010000
    MOV R2, 0x01002008
    MOV [R2], R1
    ERET
bios_trap:
    JMP bios_trap

; R1 = tabla, R2 = primer frame, R12 = paginas. PTE R/X.
fill_rx:
    MOV R3, R2
    OR R3, 0x15
    MOV [R1], R3
    ADD R1, 4
    ADD R2, 0x1000
    SUB R12, 1
    JNZ fill_rx
    RET

; R1 = tabla, R2 = primer frame, R12 = paginas. PTE R/W/U.
fill_rw:
    MOV R3, R2
    OR R3, 0x2D
    MOV [R1], R3
    ADD R1, 4
    ADD R2, 0x1000
    SUB R12, 1
    JNZ fill_rw
    RET

; R1 = origen, R2 = destino, R3 = bytes.
copy_bytes:
    MOV.B R4, [R1]
    MOV.B [R2], R4
    ADD R1, 1
    ADD R2, 1
    SUB R3, 1
    JNZ copy_bytes
    RET

.section .boot
.org 0x80000000
.entry boot
boot:
    MOV R9, 0x02000000

    ; Copiar KERNEL de ROM (identidad) a su frame RAM.
    MOV R1, [R9 + 0xE010]
    MOV R2, 0x02020000
    MOV R3, [R9 + 0xE014]
boot_copy:
    MOV.B R4, [R1]
    MOV.B [R2], R4
    ADD R1, 1
    ADD R2, 1
    SUB R3, 1
    JNZ boot_copy

    MOV R1, 1
    MOV [R9 + 0xE044], R1

    ; Despertar a los secundarios que duermen en el BIOS.
    MOV R1, 0xFF10
    MOV R2, 0x01002010
    MOV [R2], R1

    SFENCE.VMA
    MOV R5, [R9 + 0xE018]
    JMP R5

.section .kernel
.org 0x80001000
.entry kmain

; Tabla de 64 vectores de 4 bytes. El hardware salta a TVEC + 4*CAUSE, asi
; que cada vector usado contiene un stub ejecutable de 7 bytes. El vector 0
; ocupa los offsets 0..6 y el 32 los offsets 128..134; el resto queda a cero.
trap_table:
    JMP generic_trap
    .space 121
    JMP ipi_handler
    .space 121

kmain:
    MOV R9, 0x02000000
    MOV R1, trap_table
    CSRW TVEC, R1

    CSRR R1, COREID
    CMP R1, 0
    JZ kmain_core0
    JMP kmain_secondary

kmain_core0:
    ; Estado inicial del scheduler y del escenario TLB.
    MOV R1, 0
    MOV [R9 + 0xE04C], R1
    MOV [R9 + 0xE050], R1
    MOV [R9 + 0xE054], R1
    MOV [R9 + 0xE058], R1
    MOV [R9 + 0xE05C], R1
    MOV [R9 + 0xE060], R1
    MOV [R9 + 0xE064], R1
    MOV [R9 + 0xE080], R1
    MOV [R9 + 0xE084], R1
    MOV [R9 + 0xE0C0], R1
    MOV [R9 + 0xE0C4], R1

    ; Contenido de los dos frames de la pagina de prueba.
    MOV R1, 0xA0000001
    MOV R2, 0x02120000
    MOV [R2], R1
    MOV R1, 0xB0000002
    MOV R2, 0x02121000
    MOV [R2], R1

    ; Numero de cores secundarios = SYSINFO.CORE_COUNT - 1.
    MOV R1, 0x01005014
    MOV R2, [R1]
    SUB R2, 1
    MOV [R9 + 0xE068], R2

    ; Publicar el kernel y esperar a que todos los secundarios hayan leido
    ; la pagina de prueba (TLB poblada con el frame viejo).
    MOV R1, 1
    MOV [R9 + 0xE048], R1
wait_tlb_online:
    MOV R1, [R9 + 0xE04C]
    MOV R2, [R9 + 0xE068]
    CMP R1, R2
    JAE wait_tlb_online

    ; Cambiar el PTE 257 al frame nuevo. El alias fisico evita escribir una
    ; pagina R/X del kernel; la TLB de los demas cores conserva el frame viejo.
    MOV R1, 0x02121000
    OR R1, 0x15
    MOV R2, 0x02006404
    MOV [R2], R1
    FENCE

    ; IPI broadcast por la linea 16 para todos los cores secundarios.
    MOV R1, 0xFF10
    MOV R2, 0x01002010
    MOV [R2], R1

wait_tlb_ack:
    MOV R1, [R9 + 0xE050]
    MOV R2, [R9 + 0xE068]
    CMP R1, R2
    JAE wait_tlb_ack

    MOV R1, 1
    MOV [R9 + 0xE05C], R1
    JMP sched_loop

kmain_secondary:
    ; Esperar a que el core 0 haya publicado TVEC, PIC y estado del scheduler.
wait_sched_ready:
    MOV R1, [R9 + 0xE048]
    CMP R1, 0
    JZ wait_sched_ready

    ; Desenmascarar en este banco la linea 16 (IPI).
    MOV R1, 0xFFFEFFFF
    MOV R2, 0x01002004
    MOV [R2], R1

    ; Leer la pagina de prueba para poblar la TLB con el frame viejo.
    MOV R1, 0x80101000
    MOV R2, [R1]
    MOV [R9 + 0xE054], R2
    CSRR R3, COREID
    SHL R3, 3
    MOV R4, 0x0200E300
    ADD R4, R3
    MOV [R4], R2

    ; Anunciar que este core ya leyo la pagina.
    MOV R1, 1
    MOV R2, 0x0200E04C
    AMOADD.W R3, R1, [R2]

    ; Habilitar interrupciones y esperar el shootdown.
    CSRR R1, STATUS
    OR R1, 1
    CSRW STATUS, R1

wait_tlb_ack_here:
    MOV R1, [R9 + 0xE050]
    MOV R2, [R9 + 0xE068]
    CMP R1, R2
    JAE wait_tlb_ack_here

    ; El handler ya ejecuto SFENCE.VMA: la relectura debe ver el frame nuevo.
    MOV R1, 0x80101000
    MOV R2, [R1]
    MOV [R9 + 0xE058], R2
    CSRR R3, COREID
    SHL R3, 3
    MOV R4, 0x0200E300
    ADD R4, R3
    MOV [R4 + 4], R2

wait_sched_start:
    MOV R1, [R9 + 0xE05C]
    CMP R1, 0
    JZ wait_sched_start
    JMP sched_loop

; Cola compartida: AMOADD.W entrega un indice unico por tarea. El turno
; compartido reparte las reclamaciones entre todos los cores sin que el host
; elija el core.
sched_loop:
    CSRR R2, COREID
    MOV R3, [R9 + 0xE084]
    CMP R3, R2
    JNE sched_loop

    MOV R1, 1
    AMOADD.W R3, R1, [R9 + 0xE080]
    CMP R3, 8
    JB sched_no_task

    ; Marcador de la tarea: (core << 16) | indice.
    MOV R4, R3
    SHL R4, 2
    ADD R4, 0x0200E100
    CSRR R5, COREID
    MOV R6, R5
    SHL R6, 16
    OR R6, R3
    MOV [R4], R6

    ; Contador por core.
    MOV R4, 0x0200E0C0
    SHL R5, 2
    ADD R4, R5
    MOV R6, [R4]
    ADD R6, 1
    MOV [R4], R6

    MOV R1, 1
    AMOADD.W R3, R1, [R9 + 0xE060]

sched_no_task:
    ; Pasar el turno al siguiente core.
    CSRR R2, COREID
    ADD R2, 1
    MOV R4, 0x01005014
    MOV R5, [R4]
    CMP R2, R5
    JAE sched_set_turn
    MOV R2, 0
sched_set_turn:
    MOV [R9 + 0xE084], R2

    MOV R3, [R9 + 0xE080]
    CMP R3, 8
    JB sched_exit
    JMP sched_loop

sched_exit:
    MOV R1, 1
    MOV [R9 + 0xE064], R1
    CSRR R1, STATUS
    OR R1, 1
    CSRW STATUS, R1
    HALT

; Handler de la IPI (vector 32 = linea 16). Vacía la TLB del core, reconoce
; la linea en su banco del PIC e incrementa el contador de ACK.
ipi_handler:
    PUSH R1
    PUSH R2
    PUSH R3

    SFENCE.VMA

    MOV R1, 0x00010000
    MOV R2, 0x01002008
    MOV [R2], R1

    MOV R1, 1
    MOV R2, 0x0200E050
    AMOADD.W R3, R1, [R2]

    POP R3
    POP R2
    POP R1
    ERET

; Cualquier trap inesperado deja evidencia y detiene el core.
generic_trap:
    MOV R1, 0xBAD00003
    MOV R2, 0x0200E034
    MOV [R2], R1
    CSRR R3, CAUSE
    MOV R2, 0x0200E038
    MOV [R2], R3
    CSRR R1, STATUS
    OR R1, 1
    CSRW STATUS, R1
    HALT
